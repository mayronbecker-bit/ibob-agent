# Copy this file to .env for local development.
# Do not commit real secrets, tokens, passwords or private keys.

APP_NAME="iBob Agent"
APP_ENV=local

# Ports can be adjusted after the stack is chosen.
WEB_PORT=3000
API_PORT=3001
PORT=3000
NEXT_PUBLIC_APP_URL=
HOSTINGER_DOMAIN=

# Example placeholders. Keep values empty in this file.
DATABASE_URL=
AI_PROVIDER_API_KEY=
CLOUD_PROJECT_ID=

# Server-only OpenAI / ChatGPT API analysis for /agent.
# Configure real values in .env.local or Hostinger only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ANALYSIS_ENABLED=true

# Temporary access protection for the dashboard.
# Configure real values directly in Hostinger, never commit them.
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Supabase foundation.
# Use the new publishable key when available. Legacy anon keys are still
# supported by Supabase until end of 2026, but prefer publishable keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key for future admin jobs. Never expose in browser code.
SUPABASE_SECRET_KEY=
